{
  "manifest_version": 3,
  "name": "CRH Monitor",
  "version": "1.7.0",
  "description": "__MSG_extensionDescription__",
  "permissions": [
    "storage",
    "alarms",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://www.computersrh.xyz/*",
    "https://rpc.mainnet.chain.robinhood.com/*",
    "https://api.exchange.coinbase.com/*",
    "https://api.dexscreener.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "CRH Monitor",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_page": "dashboard.html",
  "content_scripts": [
    {
      "matches": [
        "https://www.computersrh.xyz/*"
      ],
      "js": [
        "page-core.js",
        "project-core.js",
        "bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.computersrh.xyz/*"
      ],
      "js": [
        "shared.js",
        "income.js",
        "i18n.js",
        "ledger.js",
        "project.js",
        "analytics.js",
        "scenarios.js",
        "reinvest-planner.js",
        "planner.js",
        "planner-view.js",
        "project-view.js",
        "view.js",
        "content.js",
        "leader-hover.js"
      ],
      "run_at": "document_start"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none';"
  },
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "default_locale": "en"
}
